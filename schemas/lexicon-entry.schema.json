{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lexicon-entry.schema.json",
  "title": "SLS Lexicon Entry",
  "description": "A Somali headword, its lexical properties, definitions, references, and provenance.",
  "schema_version": "1.2.0",
  "type": "object",
  "required": [
    "sls_id",
    "word",
    "part_of_speech",
    "dialect",
    "definitions",
    "is_loanword",
    "metadata"
  ],
  "properties": {
    "sls_id": {
      "type": "string",
      "pattern": "^sls:lex:[0-9]{6}$",
      "description": "Permanent SLS lexicon identifier."
    },
    "word": {
      "type": "string",
      "minLength": 1,
      "description": "Canonical headword written in Somali orthography."
    },
    "part_of_speech": {
      "type": "string",
      "enum": [
        "magac",
        "magacuyaal",
        "fal",
        "tilmaame",
        "falkaab",
        "meeleeye",
        "xiriiriye",
        "qodob",
        "yaab"
      ],
      "description": "Primary word class from SLS-0003 G10-R1; tifaftire remains a tilmaame subcategory."
    },
    "gender": {
      "type": "string",
      "enum": [
        "masculine",
        "feminine"
      ],
      "description": "Grammatical gender established by agreement evidence."
    },
    "plural": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Attested lexical plural form, or null when review establishes that no ordinary plural applies to the recorded reading. Null must not mean unchecked or unknown."
    },
    "ipa": {
      "type": "string",
      "minLength": 1,
      "description": "International Phonetic Alphabet transcription."
    },
    "plural_variants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Reviewed alternative plural forms; distinct from variants of the canonical headword."
    },
    "number_behavior": {
      "type": "string",
      "enum": ["plural-only"],
      "description": "Optional reviewed plural-only classification; omission makes no claim about number behavior."
    },
    "dialect": {
      "type": "string",
      "pattern": "^so(?:-x(?:-[a-z0-9]{1,8})+)?$",
      "description": "Lowercase BCP 47 language tag: so for Standard Somali or an approved private-use Somali extension."
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sense",
          "en",
          "so_gloss"
        ],
        "properties": {
          "sense": {
            "type": "integer",
            "minimum": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          },
          "so_gloss": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "synonyms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Reviewed orthographic or phonetic variants pointing to this canonical headword."
    },
    "antonyms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "is_loanword": {
      "type": ["boolean", "null"],
      "description": "True for a reviewed loanword, false for a reviewed non-loanword, or null when status is unresolved."
    },
    "loan_origin": {
      "type": "string",
      "minLength": 1,
      "description": "Source language or etymological note for a loanword."
    },
    "example_sentences": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sls:sent:[0-9]{6}$"
      },
      "uniqueItems": true
    },
    "frequency_rank": {
      "type": "integer",
      "minimum": 1
    },
    "metadata": {
      "$ref": "metadata-common.schema.json#/$defs/provenance"
    }
  },
  "allOf": [
    {
      "if": { "required": ["plural_variants"] },
      "then": {
        "properties": {
          "part_of_speech": { "const": "magac" },
          "plural": { "type": "string" }
        },
        "required": ["plural"]
      }
    },
    {
      "if": { "required": ["number_behavior"] },
      "then": {
        "properties": {
          "part_of_speech": { "const": "magac" },
          "plural": { "type": "string" }
        },
        "required": ["plural"]
      }
    },
    {
      "if": {
        "properties": {
          "part_of_speech": {
            "const": "magac"
          }
        },
        "required": [
          "part_of_speech"
        ]
      },
      "then": {
        "required": [
          "gender",
          "plural"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "is_loanword": {
            "const": true
          }
        },
        "required": [
          "is_loanword"
        ]
      },
      "then": {
        "required": [
          "loan_origin"
        ]
      },
      "else": {
        "not": {
          "required": [
            "loan_origin"
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
